<main class="container py-4">
  <%= link_to "← Back to lists", lists_path,
              class: "btn btn-outline-secondary btn-sm mb-4" %>

  <h1 class="fw-bold mb-3"><%= @list.name %></h1>

  <% if @list.photo.attached? %>
    <%= image_tag @list.photo,
                  class: "w-100 d-block rounded-3 mb-4",
                  style: "height: 320px; object-fit: cover;",
                  alt: "Cover of #{@list.name}" %>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <p class="fs-5 fw-semibold mb-0">
      <%= pluralize(@bookmarks.size, "movie") %>
    </p>
    <%= link_to "Add a movie", new_list_bookmark_path(@list),
                class: "btn btn-primary" %>
  </div>

  <div class="row g-4">
    <% @bookmarks.each do |bookmark| %>
      <% movie = bookmark.movie %>

      <div class="col-12 col-md-6 col-lg-4">
        <article class="card h-100 shadow-sm rounded-3 overflow-hidden">
          <% if movie.poster_url.present? %>
            <%= image_tag movie.poster_url,
                          class: "card-img-top",
                          style: "aspect-ratio: 2 / 3; object-fit: cover;",
                          alt: "Poster of #{movie.title}" %>
          <% end %>

          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
              <h2 class="card-title h5 fw-bold mb-0"><%= movie.title %></h2>
              <span class="badge bg-warning text-dark">
                ★ <%= movie.rating %>/10
              </span>
            </div>

            <p class="card-text"><%= movie.overview %></p>

            <% if bookmark.comment.present? %>
              <blockquote class="border-start border-3 ps-3 fst-italic text-muted">
                <%= bookmark.comment %>
              </blockquote>
            <% end %>

            <%= link_to "Remove from list", bookmark_path(bookmark),
                        class: "btn btn-outline-danger btn-sm mt-auto align-self-start",
                        data: { turbo_method: :delete, turbo_confirm: "Remove this movie?" } %>
          </div>
        </article>
      </div>
    <% end %>
  </div>
</main>
